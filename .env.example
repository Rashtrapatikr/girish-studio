# Environment Variables - Girish Studio
# Fill in your actual values before deploying

# JWT Secret Key (koi bhi random string daal do, jaise: girish_studio_2024_secret)
SECRET_KEY=your_secret_key_here

# MongoDB Connection String (Atlas se milegi)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/girishstudio?retryWrites=true&w=majority

# Cloudinary Credentials (cloudinary.com se free account banao)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (Optional - real payments ke liye)
RAZORPAY_KEY_ID=rzp_test_dummy
RAZORPAY_KEY_SECRET=dummy_secret

# Port (Render automatically set karta hai)
PORT=3000
